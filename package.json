{
  "name": "bilqis-mlx-private",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "status": "python3 -m bilqis_mlx.cli status",
    "dashboard": "python3 -m bilqis_mlx.cli dashboard",
    "diagnostics": "python3 -B -m bilqis_mlx.cli diagnostics",
    "storage:plan": "python3 -B -m bilqis_mlx.state_archive",
    "storage:compact": "python3 -B -m bilqis_mlx.state_archive --apply",
    "train": "python3 -m bilqis_mlx.cli train",
    "test": "python3 -m unittest discover -s tests -v",
    "quality:check": "python3 -B scripts/code_smell_audit.py --check-baseline docs/development/code_smell_baseline.json",
    "quality:report": "python3 -B scripts/code_smell_audit.py",
    "release:check": "python3 -B scripts/release_version.py --check",
    "backup:plan": "python3 -m bilqis_mlx.backup plan",
    "backup:copy": "python3 -m bilqis_mlx.backup copy",
    "backup:verify": "python3 -m bilqis_mlx.backup verify",
    "curriculum:audit": "python3 -m bilqis_mlx.grade_a_probe",
    "curriculum:plan": "python3 -m bilqis_mlx.registry_ast",
    "curriculum:review": "python3 -B -m bilqis_mlx.next_grade_review",
    "curriculum:coverage": "python3 -m bilqis_mlx.semantic_coverage",
    "curriculum:parity": "python3 -m bilqis_mlx.pedagogical_parity",
    "curriculum:tests": "python3 -m bilqis_mlx.semantic_test_generation",
    "curriculum:learning-smoke": "python3 -m bilqis_mlx.integer_learning_smoke",
    "curriculum:c": "python3 -B -m bilqis_mlx.grade_c_preflight",
    "grade-a:verify": "python3 -B -m bilqis_mlx.grade_a_manifest --legacy-code-root vendor/legacy-v16 --champion-checkpoint vendor/legacy-v16/runs/primitive-consolidation-v16-triplets/student-116760-7e9af4651f28.pt --verify-manifest docs/GRADE_A_CANDIDATE_MANIFEST_V2.json",
    "grade-a:baseline": "python3 -B -m bilqis_mlx.grade_a_baseline --legacy-code-root vendor/legacy-v16 --champion-checkpoint vendor/legacy-v16/runs/primitive-consolidation-v16-triplets/student-116760-7e9af4651f28.pt --grade-a-manifest docs/GRADE_A_CANDIDATE_MANIFEST_V2.json --device gpu",
    "mlx:qualify": "python3 -B -m bilqis_mlx.full_student_qualification --legacy-code-root vendor/legacy-v16 --checkpoint vendor/legacy-v16/runs/primitive-consolidation-v16-triplets/student-116760-7e9af4651f28.pt --grade-a-manifest docs/GRADE_A_CANDIDATE_MANIFEST_V2.json --verify-disposable-restart --device gpu",
    "vocabulary:preflight": "python3 -m bilqis_mlx.vocabulary_probe",
    "tokens:atlas": "python3 -m bilqis_mlx.token_atlas",
    "abi:verify": "python3 -B scripts/check_historical_abi.py"
  }
}
