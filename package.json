{
  "name": "bilqis-mlx-private",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "status": "python3 -m bilqis_mlx.cli status",
    "dashboard": "python3 -m bilqis_mlx.cli dashboard",
    "train": "python3 -m bilqis_mlx.cli train",
    "test": "python3 -m unittest discover -s tests -v",
    "backup:plan": "python3 -m bilqis_mlx.backup plan",
    "backup:copy": "python3 -m bilqis_mlx.backup copy",
    "backup:verify": "python3 -m bilqis_mlx.backup verify",
    "curriculum:audit": "python3 -m bilqis_mlx.grade_a_probe",
    "grade-a:verify": "python3 -B -m bilqis_mlx.grade_a_manifest --legacy-code-root ../bilqis-triplets-v16 --champion-checkpoint ../bilqis-triplets-v16/runs/primitive-consolidation-v16-triplets/student-116760-7e9af4651f28.pt --verify-manifest docs/GRADE_A_CANDIDATE_MANIFEST_V2.json",
    "mlx:qualify": "python3 -B -m bilqis_mlx.full_student_qualification --legacy-code-root ../bilqis-triplets-v16 --checkpoint ../bilqis-triplets-v16/runs/primitive-consolidation-v16-triplets/student-116760-7e9af4651f28.pt --grade-a-manifest docs/GRADE_A_CANDIDATE_MANIFEST_V2.json --verify-disposable-restart --device gpu",
    "vocabulary:preflight": "python3 -m bilqis_mlx.vocabulary_probe",
    "tokens:atlas": "python3 -m bilqis_mlx.token_atlas"
  }
}
