{
  "name": "bilqis-mlx-private",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "status": "python3 -m bilqis_mlx.cli status",
    "dashboard": "python3 -m bilqis_mlx.cli dashboard",
    "train": "python3 -m bilqis_mlx.cli train",
    "test": "python3 -m unittest discover -s tests -v",
    "backup:plan": "python3 -m bilqis_mlx.backup plan",
    "backup:copy": "python3 -m bilqis_mlx.backup copy",
    "backup:verify": "python3 -m bilqis_mlx.backup verify",
    "curriculum:audit": "python3 -m bilqis_mlx.grade_a_probe",
    "vocabulary:preflight": "python3 -m bilqis_mlx.vocabulary_probe",
    "tokens:atlas": "python3 -m bilqis_mlx.token_atlas"
  }
}
