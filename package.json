{
  "name": "bilqis-mlx-private",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "mission-control": "electron apps/mission-control/main.cjs",
    "mission-control:test": "node --test apps/mission-control/tests/*.test.mjs apps/mission-control/tests/domains/*.test.mjs apps/mission-control/tests/resources/*.test.mjs apps/mission-control/tests/operate/*.test.mjs",
    "abi:verify": "python3 -B scripts/check_historical_abi.py",
    "backup:copy": "python3 -m bilqis_mlx.backup copy",
    "backup:plan": "python3 -m bilqis_mlx.backup plan",
    "backup:verify": "python3 -m bilqis_mlx.backup verify",
    "curriculum:audit": "python3 -m bilqis_mlx.grade_a_probe",
    "curriculum:c": "python3 -B -m bilqis_mlx.grade_c_preflight",
    "curriculum:coverage": "python3 -m bilqis_mlx.semantic_coverage",
    "curriculum:learning-smoke": "python3 -m bilqis_mlx.integer_learning_smoke",
    "curriculum:parity": "python3 -m bilqis_mlx.pedagogical_parity",
    "curriculum:plan": "python3 -m bilqis_mlx.registry_ast",
    "curriculum:review": "python3 -B -m bilqis_mlx.next_grade_review",
    "curriculum:tests": "python3 -m bilqis_mlx.semantic_test_generation",
    "dashboard": "python3 -B -m bilqis_mlx.presentation.dashboard_watch",
    "diagnostics": "python3 -B -m bilqis_mlx.cli diagnostics",
    "explain": "python3 -m bilqis_mlx.cli explain -- ",
    "grade-a:baseline": "python3 -B -m bilqis_mlx.grade_a_baseline --legacy-code-root vendor/legacy-v16 --champion-checkpoint vendor/legacy-v16/runs/primitive-consolidation-v16-triplets/student-116760-7e9af4651f28.pt --grade-a-manifest docs/provenance/GRADE_A_CANDIDATE_MANIFEST_V2.json --device gpu",
    "grade-a:verify": "python3 -B -m bilqis_mlx.grade_a_manifest --legacy-code-root vendor/legacy-v16 --champion-checkpoint vendor/legacy-v16/runs/primitive-consolidation-v16-triplets/student-116760-7e9af4651f28.pt --verify-manifest docs/provenance/GRADE_A_CANDIDATE_MANIFEST_V2.json",
    "learning:report": "python3 -B -m bilqis_mlx.diagnostics.learning_report",
    "mission-control:security:test": "node --test apps/mission-control/electron/tests/*.test.cjs && python3 -B -m unittest bilqis_mlx.mission_control.tests.test_electron_bridge",
    "mlx:qualify": "python3 -B -m bilqis_mlx.full_student_qualification --legacy-code-root vendor/legacy-v16 --checkpoint vendor/legacy-v16/runs/primitive-consolidation-v16-triplets/student-116760-7e9af4651f28.pt --grade-a-manifest docs/provenance/GRADE_A_CANDIDATE_MANIFEST_V2.json --verify-disposable-restart --device gpu",
    "quality:check": "python3 -B scripts/quality/check_governance_integrity.py && python3 -B scripts/check_factory_architecture.py && python3 -B scripts/quality/check_docs.py && if [ -n \"${BILQIS_QUALITY_BASE_REF:-}\" ]; then python3 -B scripts/error_control_plane.py --check --base-ref \"$BILQIS_QUALITY_BASE_REF\" && python3 -B scripts/code_smell_audit.py --changed-from \"$BILQIS_QUALITY_BASE_REF\" --check-baseline docs/evidence/development/code_smell_baseline.json; else python3 -B scripts/error_control_plane.py --check && python3 -B scripts/code_smell_audit.py --check-baseline docs/evidence/development/code_smell_baseline.json; fi && npm run bamf:legacy-trainer && npm run bamf:legacy-trainer:test && npm run bamf:flow-control && npm run bamf:flow-control:test",
    "quality:changed": "npm run quality:structure && python3 -B scripts/code_smell_audit.py --changed-from \"${BILQIS_QUALITY_BASE_REF:-HEAD}\" --check-baseline docs/evidence/development/code_smell_baseline.json && npm run bamf:legacy-trainer && npm run bamf:legacy-trainer:test && npm run bamf:flow-control && npm run bamf:flow-control:test",
    "quality:report": "python3 -B scripts/code_smell_audit.py",
    "quality:structure": "python3 -B scripts/check_module_size.py --changed-from \"${BILQIS_QUALITY_BASE_REF:-HEAD}\" && python3 -B scripts/quality/check_governance_integrity.py --base-ref \"${BILQIS_QUALITY_BASE_REF:-HEAD}\"",
    "prepare": "husky",
    "release:check": "python3 -B scripts/maintenance/release_version.py --check",
    "start": "npm run train -- --human-run --source-prefetch-workers 2 --run-dir ./runs/codex-0001-prometheus --resume --minutes 180",
    "start:flash": "npm run train -- --human-run --run-dir ./runs/codex-0001-prometheus --resume --minutes 180 --flash-mode",
    "status": "python3 -m bilqis_mlx.cli status",
    "storage:compact": "python3 -B -m bilqis_mlx.state_archive --apply",
    "storage:dag-migrate": "python3 -B -m bilqis_mlx.state_dag migrate",
    "storage:dag-migrate-history": "python3 -B -m bilqis_mlx.state_dag migrate-history",
    "storage:dag-status": "python3 -B -m bilqis_mlx.state_dag status",
    "storage:plane-dedupe-bundles": "python3 -B -m bilqis_mlx.data_plane dedupe-bundles",
    "storage:plane-warm-events": "python3 -B -m bilqis_mlx.data_plane warm-events",
    "storage:plane-warm": "python3 -B -m bilqis_mlx.data_plane warm-custody",
    "storage:plane-status": "python3 -B -m bilqis_mlx.data_plane status",
    "storage:purge": "npm run storage:compact -- --run-dir ./runs/codex-0001-prometheus --max-files 0",
    "storage:plan": "python3 -B -m bilqis_mlx.state_archive",
    "test": "python3 -B scripts/run_tests.py",
    "test:changed": "python3 -B scripts/testing/differential_test_gate.py leaf",
    "test:premerge": "python3 -B scripts/testing/differential_test_gate.py premerge",
    "test:status": "python3 -B scripts/testing/differential_test_gate.py status",
    "test:skos:full": "python3 -B scripts/run_tests.py lib/ithkuil/tests",
    "test:skos:changed": "python3 -B scripts/skos_test_policy.py run",
    "test:skos:status": "python3 -B scripts/skos_test_policy.py status",
    "tokens:atlas": "python3 -m bilqis_mlx.token_atlas",
    "train": "python3 -m bilqis_mlx.cli train",
    "verify": "python3 -B -m bilqis_mlx.cli train --dry-run --verify-source --source-prefetch-workers 2 --run-dir ./runs/codex-0001-prometheus --resume",
    "verify:leaf": "npm run quality:changed && npm run test:changed && npm run mission-control:test && npm run mission-control:security:test",
    "verify:premerge": "npm run quality:check && npm run test:premerge && npm run mission-control:test && npm run mission-control:security:test",
    "vocabulary:preflight": "python3 -m bilqis_mlx.vocabulary_probe",
    "bamf:legacy-trainer": "python3 -B scripts/check_legacy_trainer_authority.py",
    "bamf:legacy-trainer:test": "python3 -B -m unittest scripts.tests.test_legacy_trainer_authority",
    "bamf:flow-control": "python3 -B scripts/check_bamf_flow_control.py",
    "bamf:flow-control:test": "python3 -B -m unittest scripts.tests.test_bamf_flow_control scripts.tests.test_bamf_flow_control_live"
  },
  "devDependencies": {
    "electron": "42.11.16",
    "husky": "9.1.7"
  }
}
